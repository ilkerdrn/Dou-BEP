{
  "name": "bep-sinav-atolyesi",
  "private": true,
  "version": "2.81.0",
  "description": "DOU BEP v2.81: onaylı sınav uçtan uca kapanış provası ve doğrulanmış PDF/ZIP indirme",
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "dev": "node server.mjs",
    "test": "node --test *.test.mjs server-foundation/*.test.mjs tools/*.test.mjs",
    "backup": "node tools/secure-backup.mjs backup",
    "release:check": "node release-check.mjs",
    "backup:verify": "node tools/secure-backup.mjs verify",
    "backup:restore": "node tools/secure-backup.mjs restore",
    "backup:unsafe-legacy": "node tools/backup.mjs",
    "package:verify": "node tools/verify-batch-package.mjs",
    "offline:audit": "node tools/offline-audit.mjs",
    "security:check": "node tools/security-readiness.mjs",
    "acceptance:pilot": "node tools/acceptance-pilot.mjs",
    "storage:check": "node tools/protected-storage.mjs",
    "backup:rotate": "node tools/secure-backup.mjs rotate",
    "pdf:preflight": "node tools/pdf-preflight.mjs",
    "pdf:font-check": "node tools/pdf-font-check.mjs",
    "audit:key": "node tools/audit-evidence-cli.mjs init-key",
    "audit:seal": "node tools/audit-evidence-cli.mjs seal",
    "audit:verify": "node tools/audit-evidence-cli.mjs verify",
    "pdf:code-font-check": "node tools/pdf-code-font-check.mjs",
    "audit:rotate": "node tools/audit-evidence-cli.mjs rotate",
    "audit:verify-rotation": "node tools/audit-evidence-cli.mjs verify-rotation",
    "backup:attested": "node tools/attested-backup.mjs backup",
    "backup:attested-restore": "node tools/attested-backup.mjs restore",
    "storage:drill": "node tools/storage-recovery-drill.mjs",
    "storage:preflight": "node tools/storage-migration-preflight.mjs",
    "reader:windows": "powershell.exe -NoProfile -STA -ExecutionPolicy Bypass -File tools/dou-reader-windows.ps1",
    "speech:lab": "node tools/dou-speech-preview.mjs --help",
    "speech:phoneme-audit": "node tools/dou-speech-phoneme-audit.mjs",
    "reader:windows:check": "powershell.exe -NoProfile -STA -ExecutionPolicy Bypass -File tools/dou-reader-windows.ps1 -Check",
    "speech:boundary-audit": "node tools/dou-speech-boundary-audit.mjs",
    "speech:corpus-audit": "node tools/dou-speech-corpus-audit.mjs",
    "speech:join-audit": "node tools/dou-speech-join-audit.mjs",
    "speech:orthography-audit": "node tools/dou-speech-orthography-audit.mjs",
    "speech:exception-audit": "node tools/dou-speech-exception-audit.mjs",
    "speech:exception-plan-audit": "node tools/dou-speech-exception-plan-audit.mjs",
    "speech:cadence-audit": "node tools/dou-speech-cadence-audit.mjs",
    "speech:continuity-audit": "node tools/dou-speech-continuity-audit.mjs",
    "exam:closure": "node tools/exam-closure-smoke.mjs",
    "reader:pronunciation:check": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File tools/dou-reader-pronunciation-check.ps1",
    "reader:acceptance:windows": "powershell.exe -NoProfile -STA -ExecutionPolicy Bypass -File tools/dou-reader-windows-acceptance.ps1",
    "ui:browser": "node tools/browser-ui-acceptance.mjs",
    "reader:voice:diagnose": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File tools/dou-reader-voice-readiness.ps1",
    "speech:fixed-phrase:report": "node tools/dou-speech-fixed-phrase-report.mjs",
    "speech:fixed-phrase:test": "node --test tools/dou-speech-fixed-phrase-bench.test.mjs",
    "speech:fixed-phrase:export:test": "node --test tools/dou-speech-fixed-phrase-export.test.mjs",
    "design:v3:check": "node --test bep-design-system.test.mjs",
    "design:v3:acceptance": "npm run design:v3:check && npm run ui:browser",
    "design:v4:check": "node --test bep-v4-design.test.mjs",
    "design:v4:acceptance": "npm run design:v4:check && npm run ui:browser",
    "design:v4:inventory": "node tools/v4-css-migration-audit.mjs --strict"
  },
  "engines": {
    "node": ">=22.13"
  }
}
